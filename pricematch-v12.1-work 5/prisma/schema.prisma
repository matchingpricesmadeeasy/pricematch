generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid()); email String @unique; passwordHash String; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt
  sessions Session[]; watchlistItems WatchlistItem[]; notifications NotificationLog[]; dealClicks DealClick[]; analyticsEvents AnalyticsEvent[]
}
model Session { id String @id @default(cuid()); token String @unique; userId String; expiresAt DateTime; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId,expiresAt]) }
model Product { id String @id @default(cuid()); canonicalId String @unique; title String; brand String?; model String?; imageUrl String?; attributesJson String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; identifiers ProductIdentifier[]; offers Offer[]; watchlistItems WatchlistItem[]; analyticsEvents AnalyticsEvent[] }
model ProductIdentifier { id String @id @default(cuid()); type String; value String; productId String; product Product @relation(fields:[productId],references:[id],onDelete:Cascade); @@unique([type,value]); @@index([productId]) }
model RetailerSource { id String @id @default(cuid()); key String @unique; name String; enabled Boolean @default(true); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; offers Offer[]; analyticsEvents AnalyticsEvent[] }
model Offer { id String @id @default(cuid()); productId String; retailerId String; retailerSku String?; title String; price Float; shipping Float?; currency String @default("USD"); availability String @default("unknown"); url String; matchConfidence Float; matchReason String?; firstSeenAt DateTime @default(now()); lastSeenAt DateTime @default(now()); product Product @relation(fields:[productId],references:[id],onDelete:Cascade); retailer RetailerSource @relation(fields:[retailerId],references:[id]); snapshots PriceSnapshot[]; dealClicks DealClick[]; @@unique([productId,retailerId,retailerSku]); @@index([productId,lastSeenAt]) }
model PriceSnapshot { id String @id @default(cuid()); offerId String; price Float; shipping Float?; total Float; currency String @default("USD"); availability String @default("unknown"); capturedAt DateTime @default(now()); offer Offer @relation(fields:[offerId],references:[id],onDelete:Cascade); @@index([offerId,capturedAt]) }
model WatchlistItem { id String @id @default(cuid()); userKey String?; userId String?; productId String; targetPrice Float?; active Boolean @default(true); lastAlertedPrice Float?; lastCheckedAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; user User? @relation(fields:[userId],references:[id],onDelete:Cascade); product Product @relation(fields:[productId],references:[id],onDelete:Cascade); @@unique([userKey,productId]); @@index([userId,active]); @@index([userKey,active]) }
model NotificationLog { id String @id @default(cuid()); userId String; watchlistItemId String; channel String; status String; subject String; message String; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId,createdAt]) }
model DealClick { id String @id @default(cuid()); offerId String; userId String?; retailer String; destinationHost String; createdAt DateTime @default(now()); offer Offer @relation(fields:[offerId],references:[id],onDelete:Cascade); user User? @relation(fields:[userId],references:[id],onDelete:SetNull); @@index([offerId,createdAt]); @@index([retailer,createdAt]) }
model AnalyticsEvent { id String @id @default(cuid()); name String; userId String?; productId String?; retailerId String?; sessionKey String?; path String?; metadataJson String?; createdAt DateTime @default(now()); user User? @relation(fields:[userId],references:[id],onDelete:SetNull); product Product? @relation(fields:[productId],references:[id],onDelete:SetNull); retailer RetailerSource? @relation(fields:[retailerId],references:[id],onDelete:SetNull); @@index([name,createdAt]); @@index([productId,createdAt]); @@index([retailerId,createdAt]) }
